{
  "name": "homeflow",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,mcp \"next dev\" \"tsx watch server/index.ts\"",
    "mcp": "tsx server/index.ts",
    "mcp:smoke": "tsx scripts/smoke-mcp.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app lib scripts server tests eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.745.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "cors": "^2.8.6",
    "express": "5.3.0",
    "next": "16.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "tsx": "4.23.15",
    "typescript": "^5.9.0"
  },
  "optionalDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3"
  }
}
