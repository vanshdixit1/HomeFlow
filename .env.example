MCP_PORT=3001
MCP_HOST=127.0.0.1
MCP_URL=http://127.0.0.1:3001/mcp
MCP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Required when NODE_ENV=production; generate with node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# MCP_AUTH_TOKEN=
# Required when NODE_ENV=production. Use a unique household password and random session secret.
# HOMEFLOW_ACCESS_PASSWORD=
# HOMEFLOW_SESSION_SECRET=
# Optional: absolute path to a SQLite file. Default: data/homeflow.sqlite
# HOMEFLOW_DB=

# Optional Amazon Bedrock intent extraction; use AWS_PROFILE locally or an IAM role in AWS.
HOMEFLOW_BEDROCK_ENABLED=false
# AWS_REGION=us-east-1
# AWS_PROFILE=default
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0